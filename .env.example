# Lumbung Bersama local environment
# Copy to .env.local and fill only the integrations you want to enable.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required application database
DATABASE_URL=postgresql://lumbung:lumbung_local_password@localhost:5432/lumbung_bersama
POSTGRES_POOL_MAX=5
# Use `require` for managed Postgres providers that require SSL.
PGSSLMODE=

# Operator login, no public register
ADMIN_EMAIL=admin@lumbung-bersama.local
# Generate with: npm run auth:hash-password -- "your-long-password"
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Admin Lumbung
SESSION_TTL_HOURS=10

# Live AI extraction and agent reasoning
OPENAI_API_KEY=

# WhatsApp Business Platform Cloud API
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Geospatial production storage
POSTGIS_URL=

# Media storage for farmer photos and voice-note transcripts
S3_OR_R2_BUCKET=
S3_OR_R2_REGION=
S3_OR_R2_ACCESS_KEY_ID=
S3_OR_R2_SECRET_ACCESS_KEY=
S3_OR_R2_PUBLIC_BASE_URL=

# Official/statistical data connectors
BPS_API_KEY=
DATA_PIPELINE_SECRET=
WILAYAH_SOURCE_URL=https://raw.githubusercontent.com/cahyadsn/wilayah/master/db/wilayah.sql
WILAYAH_IMPORT_BATCH_SIZE=500
COMMODITY_IMPORT_BATCH_SIZE=320
# Optional, for dry-runs only. Leave empty/0 in production so every area is covered.
COMMODITY_IMPORT_AREA_LIMIT=0
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Koperasi and government-system integration placeholders
SIMKOPDES_API_BASE=
SIMKOPDES_CLIENT_ID=
SIMKOPDES_CLIENT_SECRET=
